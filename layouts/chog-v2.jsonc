// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// magic keys
//   *   default repeat
//         '* -> 's
//         a* -> au
//         b* -> bl
//         g* -> gl
//         h* -> he
//         m* -> mp
//         o* -> ou
//         r* -> rl
//         u* -> ua
//         w* -> wl
//         y* -> ys
//
{
  "board": {
    "isRowStaggered": false,
    "mirrorLeftRowStagger": false,
    "rowOrColumnStagger": [
      0,
      0,
      0
    ],
    "splitAngle": 0
  },
  "fingermap": [
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9"
  ],
  "layers": null,
  "layout": {
    "fingers": [
      "x k l c p z y o h ,",
      "n t r d m ' s a e i",
      "b v j g w q f u ; ."
    ],
    "thumbs": [
      "space",
      "*"
    ]
  },
  "magic": {
    "magicKeys": [],
    "rules": [
      {
        "inputs": "x*",
        "output": "xx"
      },
      {
        "inputs": "k*",
        "output": "kk"
      },
      {
