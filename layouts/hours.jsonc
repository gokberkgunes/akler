// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// magic keys
//   ★   default repeat
//         n★ -> nl
//         r★ -> rn
//         u★ -> u'
//         y★ -> ys
//
// adaptive swaps
//   after u, the next i and o trade places
//   after r, the next l and h trade places
//   after h, the next . and x trade places
//
{
  "layout": {
    "fingers": [
      "k ★ f y w q j u o .",
      "t m s d g x r i a h",
      "z v p c b l n , ? '"
    ],
    "thumbs": [
      "",
      "e"
    ]
  },
  "fingermap": [
    "0 1 2 2 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 3 3 3 6 6 7 8 9"
  ],
  "board": {
    "isRowStaggered": true,
    "mirrorLeftRowStagger": false,
    "splitAngle": 0,
    "rowOrColumnStagger": [
      0,
      0.25,
      0.75
    ]
  },
  "layers": null,
  "magic": {
    "magicKeys": [],
    "rules": [
      {
