// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// magic keys
//   ◇   default repeat
//         '◇ -> 'r
//         a◇ -> ay
//         h◇ -> hr
//         i◇ -> ik
//         j◇ -> jo
//         k◇ -> ke
//         r◇ -> rl
//         u◇ -> u'
//         y◇ -> ye
//
// adaptive swaps
//   after j, the next n and u trade places
//   after u, the next e and o trade places
//   after ', the next l and f trade places
//   after y, the next , and u trade places
//
// alt fingers
//   t◇ t_◇ (LM LR) · p◇ (LI LM) · ◇p (LM LI) · e, (RM RT) · rk (RM RI)
//
{
  "board": {
    "isRowStaggered": true,
    "mirrorLeftRowStagger": false,
    "rowOrColumnStagger": [
      0,
      0.25,
      0.75
    ],
    "splitAngle": 0
  },
  "fingermap": [
    "0 1 2 2 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 3 3 3 6 6 7 8 9"
  ],
  "layers": null,
  "layout": {
    "fingers": [
      "b f ◇ p w ' . u o y",
      "n s t d g k r e a i",
      "q v c m x l h , z j"
    ],
