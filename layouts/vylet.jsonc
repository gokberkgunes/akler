// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// magic keys
//   *   default repeat
//         '* -> 'l
//         a* -> ax
//         b* -> bt
//         c* -> ck
//         e* -> ex
//         f* -> ft
//         g* -> gh
//         i* -> ix
//         m* -> mb
//         p* -> pt
//         r* -> rk
//         s* -> sc
//         w* -> wr
//
{
  "layout": {
    "fingers": [
      "w c m p b x l o u j -",
      "r s t h f y n a e i ,",
      "q v g d k z * ' ; . skip"
    ],
    "thumbs": [
      "",
      ""
    ]
  },
  "fingermap": [
    "0 1 2 3 3 6 6 7 8 9 9",
    "0 1 2 3 3 6 6 7 8 9 9",
    "0 1 2 3 3 6 6 7 8 9 0"
  ],
  "board": {
    "isRowStaggered": true,
    "mirrorLeftRowStagger": false,
    "splitAngle": 0,
    "rowOrColumnStagger": [
      0,
      0.25,
      0.75
    ]
  },
  "layers": null,
  "magic": {
    "magicKeys": [],
    "rules": [
      {
        "inputs": "'*",
        "output": "'l"
      },
      {
        "inputs": ",*",
        "output": ",,"
      },
      {
        "inputs": "-*",
        "output": "--"
      },
      {
        "inputs": ".*",
        "output": ".."
      },
      {
        "inputs": ";*",
        "output": ";;"
      },
      {
