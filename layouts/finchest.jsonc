// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// adaptive swaps
//   after f, the next q and t trade places
//   after g, the next s and x trade places
//   after n, the next ' and r trade places
//   after p, the next d and h trade places
//   after r, the next h and l trade places
//   after x, the next g and p trade places
//   after y, the next q and s trade places
//   after l, the next l and t trade places
//
{
  "board": {
    "isRowStaggered": true,
    "mirrorLeftRowStagger": false,
    "rowOrColumnStagger": [
      0,
      0,
      0
    ],
    "splitAngle": 0
  },
  "fingermap": [
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9"
  ],
  "layers": null,
  "layout": {
    "fingers": [
      "v l y d k x h a , ;",
      "c r s t f b n o i u",
      "z w g m j q p ' . /"
    ],
    "thumbs": [
      "space",
      "e"
    ]
  },
  "magic": {
    "magicKeys": [],
    "rules": [
