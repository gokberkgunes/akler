// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// magic keys
//   @   default repeat
//         b@ -> br
//         r@ -> rl
//         y@ -> y,
//
// adaptive swaps
//   after s, the next c and r trade places
//   after g, the next s and t trade places
//   after y, the next i and d trade places
//
{
  "layout": {
    "fingers": [
      "b l @ m v ' k i a .",
      "n r t s w f d y o u",
      "q j c g x p h , ? z"
    ],
    "thumbs": [
      "",
      "e"
    ]
  },
  "fingermap": [
    "0 1 2 2 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 3 3 3 6 6 7 8 9"
  ],
  "board": {
    "isRowStaggered": true,
    "mirrorLeftRowStagger": false,
    "splitAngle": 0,
    "rowOrColumnStagger": [
      0,
      0.25,
      0.75
    ]
  },
  "layers": null,
  "magic": {
    "keys": "@",
    "magicKeys": [],
    "rules": [
      {
        "inputs": "'@",
        "output": "''"
      },
      {
        "inputs": ",@",
        "output": ",,"
      },
      {
        "inputs": ".@",
        "output": ".."
      },
      {
        "inputs": "?@",
        "output": "??"
      },
      {
        "inputs": "a@",
        "output": "aa"
      },
      {
        "inputs": "b@",
