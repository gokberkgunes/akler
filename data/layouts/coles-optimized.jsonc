            },
            {
                "inputs": "%z",
                "output": "%z"
            },
            {
                "inputs": "'*",
                "output": "''"
            },
            {
                "inputs": ",*",
                "output": ",,"
            },
            {
                "inputs": ".*",
                "output": ".."
            },
            {
