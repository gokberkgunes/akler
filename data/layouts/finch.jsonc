// Magic rules, as authored. The "magic.rules" list below is the
// COMPILED form of exactly these -- one input/output pair per key.
//
// adaptive swaps
//   after g, the next s and x trade places
//   after g, the next y and d trade places
//   after s, the next y and r trade places
//   after r, the next h and l trade places
//   after t, the next w and g trade places
//   after u, the next ' and h trade places
//   after l, the next w and l trade places
//   after p, the next h and d trade places
//   after n, the next ' and r trade places
//
{
  "board": {
    "isRowStaggered": true,
    "mirrorLeftRowStagger": false,
    "rowOrColumnStagger": [
      0,
      0,
      0
    ],
    "splitAngle": 0
  },
  "fingermap": [
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9",
    "0 1 2 3 3 6 6 7 8 9"
  ],
  "layers": null,
  "layout": {
    "fingers": [
      "v l y w j q f o . ;",
      "c r s t m p n a i u",
      "z x g d k b h ' , /"
    ],
